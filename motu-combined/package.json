{
  "name": "motu-combined",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "MOTU AVB Series, UltraLite-mk5 & 828, and M-Series combined — a 180 s 4K vertical reel (2160x3840) and a 300 s 4K landscape explainer (3840x2160) from one Remotion project. Shivansh Electronics — Exclusive Partner of MOTU for East & North-East India.",
  "scripts": {
    "studio": "remotion studio",
    "typecheck": "tsc --noEmit",
    "assets": "python3 scripts/prep_assets.py",
    "broll": "python3 scripts/prep_broll.py",
    "audio": "python3 scripts/gen_audio.py",
    "timeline": "node --experimental-strip-types scripts/timeline.mjs",
    "render:reel": "sh scripts/render.sh Reel motu-combined-reel 5400 450",
    "render:video": "sh scripts/render.sh Explainer motu-combined-explainer 9000 450",
    "thumb:reel": "remotion still ThumbnailReel out/motu-combined-reel-cover.png",
    "thumb:video": "remotion still ThumbnailVideo out/motu-combined-explainer-cover.png"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.497",
    "@remotion/cli": "4.0.497",
    "@remotion/renderer": "4.0.497",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.497"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "typescript": "5.6.3"
  }
}
